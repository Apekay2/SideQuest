# Side Qwest configuration. Every variable is validated at boot by packages/config/src/env.ts;
# production refuses placeholders, reused secrets and every development driver.
# For local development, `node scripts/dev-env.mjs` writes a working .env instead of this file.
# Replace every CHANGEME (boot refuses it) with generated material: openssl rand -base64 48

# ── runtime
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# ── databases: the owner runs migrations; the services connect as the RLS roles only
MIGRATE_DATABASE_URL=postgres://postgres:<owner-password>@db:5432/sidequest
APP_ROLE_PASSWORD=CHANGEME
DATABASE_URL=postgres://sidequest_app:<password>@db:5432/sidequest
OPS_DATABASE_URL=postgres://sidequest_ops:<password>@db:5432/sidequest
WORKER_DATABASE_URL=postgres://sidequest_worker:<password>@db:5432/sidequest
DATABASE_POOL_MAX=20
REDIS_URL=redis://redis:6379

# ── secrets (distinct values; reuse across purposes is refused)
JWT_SECRET=CHANGEME
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
COOKIE_SECRET=CHANGEME
KYC_ENCRYPTION_KEY=CHANGEME
KYC_ENCRYPTION_KEY_ID=prod-1
HANDOVER_SECRET=CHANGEME

# ── edge
ALLOWED_ORIGINS=https://console.sidequest.co.ke
API_PUBLIC_ORIGIN=https://api.sidequest.co.ke
COOKIE_DOMAIN=sidequest.co.ke
CSP_REPORT_URI=
# The ops console's server address (it calls /ops server-to-server); required in production.
OPS_IP_ALLOWLIST=
# Load balancer hops that append X-Forwarded-For; the client IP is the entry before them.
TRUSTED_PROXY_HOPS=1

# ── storage (local is refused in production)
STORAGE_DRIVER=r2
STORAGE_LOCAL_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=CHANGEME
R2_SECRET_ACCESS_KEY=CHANGEME
R2_BUCKET=
PRESIGN_TTL_SECONDS=300

# ── M-Pesa (fake is refused in production)
DARAJA_DRIVER=daraja
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=CHANGEME
DARAJA_CONSUMER_SECRET=CHANGEME
DARAJA_SHORTCODE=
DARAJA_PASSKEY=CHANGEME
DARAJA_B2C_INITIATOR=
DARAJA_B2C_CREDENTIAL=CHANGEME
DARAJA_CALLBACK_BASE=https://api.sidequest.co.ke
# Secret path segment in every callback URL handed to Safaricom (Daraja does not sign callbacks).
DARAJA_CALLBACK_TOKEN=CHANGEME
# Safaricom's published callback source ranges, comma-separated.
DARAJA_SOURCE_CIDRS=

# ── card issuer (mock is refused in production)
ISSUER_DRIVER=union
ISSUER_BASE_URL=
ISSUER_API_KEY=CHANGEME
ISSUER_WEBHOOK_SECRET=CHANGEME

# ── SMS (console is refused in production)
SMS_DRIVER=africastalking
AT_USERNAME=
AT_API_KEY=CHANGEME
AT_SENDER_ID=SIDEQWEST

# ── app-store review sign-in (both or neither; remove after review — see RELEASE.md)
# A number nobody owns; it signs in with this fixed code and receives no SMS.
REVIEW_LOGIN_MSISDN=
REVIEW_LOGIN_CODE=

# ── push notifications (console is refused in production)
PUSH_DRIVER=expo
# Only if the Expo project enables "enhanced push security" (expo.dev → project → credentials).
EXPO_ACCESS_TOKEN=CHANGEME

# ── telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── business rules (defaults shown)
PLATFORM_FEE_BPS=1200
MIN_PAYOUT_CENTS=10000
CANCEL_FEE_CAP_CENTS=15000
AUCTION_MIN_MINUTES=5
AUCTION_MAX_MINUTES=60
REIMBURSEMENT_WINDOW_MS=300000
MAX_EVIDENCE_ATTEMPTS=2

# ── ops console (apps/console)
API_URL=https://api.sidequest.co.ke
STORAGE_PUBLIC_ORIGIN=
