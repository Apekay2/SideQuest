{
  "name": "@sidequest/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "gates": "tsx scripts/assert-rls-coverage.ts && tsx scripts/assert-currency-invariants.ts && tsx scripts/assert-ledger-grants.ts"
  },
  "dependencies": {
    "@sidequest/domain": "workspace:*",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
