{
  "name": "@sidequest/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/caprasimo": "^0.4.0",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@sidequest/contracts": "workspace:*",
    "@sidequest/domain": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-qrcode-svg|@noble/.*|@sidequest/.*)"
        ],
        "setupFiles": [
          "./jest.setup.js"
        ],
        "testMatch": [
          "<rootDir>/src/**/*.test.ts?(x)"
        ],
        "preset": "jest-expo/ios",
        "displayName": "ios"
      },
      {
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-qrcode-svg|@noble/.*|@sidequest/.*)"
        ],
        "setupFiles": [
          "./jest.setup.js"
        ],
        "testMatch": [
          "<rootDir>/src/**/*.test.ts?(x)"
        ],
        "preset": "jest-expo/android",
        "displayName": "android"
      }
    ]
  }
}
